# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# Database Runtime Artifacts
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ------------------------------------------------------------------------------
# Embedded & STM32 Firmware
# ------------------------------------------------------------------------------
# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
compile_commands.json
.clangd/

# Build outputs
*.o
*.obj
*.elf
*.bin
*.hex
*.map
*.d

# STM32CubeMX Toolchain & IDE Folders
.mxproject
EWARM/
MDK-ARM/
SW4STM32/
STM32CubeIDE/

# STM32 HAL / CMSIS vendor drivers (managed via PlatformIO stm32cube framework)
Drivers/

# CubeMX backups
*.ioc.bak

# ------------------------------------------------------------------------------
# IDEs & System Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
.DS_Store
Thumbs.db
.directory
